<%
  url =
    if project_tasks_subscription.persisted?
      project_tasks_subscription_path(project, project_tasks_subscription)
    else
      project_tasks_subscriptions_path(project)
    end
%>
<%= form_with(model: project_tasks_subscription,
              url: url,
              html: { name: 'project_tasks_subscription_form',
                      class: 'task-subscription-form' },
              data: { turbo_method: :post }) do |form| %>
  <%= form.submit 'Auto-Subscribe to New Tasks',
                  class: 'button button-clear button-wrap',
                  data: { disable_with: 'Subscribing...', turbo_submit_with: 'Subscribing...' } %>
<% end %>
