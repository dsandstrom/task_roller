<%= category_reposition_header %>

<div class="categories categories-and-projects">
  <% @categories.each do |category| %>
    <% projects = category.projects.accessible_by(current_ability).order(:position) %>
    <%= content_tag :div, id: "category-#{category.id}",
                          class: 'category-and-projects',
                          data: { sortable_url: reposition_category_url(category) } do %>
      <div class="category-name">
        <%= content_tag :h3, category.name %>
        <%= category_tags(category) %>
        <%= content_tag :span, icon('arrow-expand'),
                        class: 'sortable-handle category-sortable-handle' %>
      </div>

      <% if projects.any? %>
        <ol class="category-projects-list">
          <% projects.each do |project| %>
            <%= content_tag :li, id: "project-#{project.id}",
                                 class: 'category-project',
                                 data: { sortable_url: reposition_project_url(project) } do %>
              <%= content_tag :span, project.name,
                              class: 'category-project-name' %>
              <%= content_tag :span, icon('hamburger'),
                              class: 'sortable-handle project-sortable-handle' %>
            <% end %>
          <% end %>
        </ol>
      <% end %>
    <% end %>
  <% end %>
</div>
