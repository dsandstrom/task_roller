<%= project_header @project %>

<% if @search_results.any? || searching? %>
  <%= render 'shared/page_links',
             collection: @search_results %>
<% end %>

<div class="columns">
  <div class="second-column">
    <%= render 'shared/filter_form', path: project_path(@project),
                                     search_subscription: @search_subscription %>
  </div>

  <div class="first-column">
    <% if @search_results.any? || searching? %>
      <div class="issues tasks">
        <% @search_results.each do |search_result| %>
          <%= search_result_turbo_frame(search_result) %>
        <% end %>
      </div>

      <%= render 'shared/simple_page_links',
                 collection: @search_results %>
    <% else %>
      <p class="no-task no-issue">None found</p>
    <% end %>
  </div>
</div>
