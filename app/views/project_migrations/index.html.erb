<%= content_for :header do %>
  <h1>Project Migrator</h1>
  <%= app_setup_nav %>
<% end %>

<%= content_tag :h2, "All Categories & Projects" %>

<p>Pick a project to start migrating all of it's issues and tasks:</p>

<% if @categories.any? %>
  <ul>
    <% @categories.each do |category| %>
      <li>
        <%= category.name %>
        <ul>
          <% category.projects.order(:position).each do |project| %>
            <li>
              <%= link_to project.name_and_tag, new_project_migration_path(project) %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to 'Back', :back %></p>
