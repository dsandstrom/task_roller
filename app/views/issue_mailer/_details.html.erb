<h2>Issue Details</h2>
<%= content_tag :h3, issue.summary, class: 'issue-summary' %>

<%= content_tag :div do %>
  <%= content_tag :p, "Type: #{issue.issue_type&.name}" %>
  <%= content_tag :p, "Status: #{issue.status&.titleize}" %>
<% end %>

<%= content_tag :div, issue.description_html.html_safe,
                class: 'issue-description' %>
