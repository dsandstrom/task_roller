<%
  url =
    if category_tasks_subscription.persisted?
      category_tasks_subscription_path(category, category_tasks_subscription)
    else
      category_tasks_subscriptions_path(category)
    end
%>
<%= form_with(model: category_tasks_subscription,
              url: url,
              html: { name: 'task_subscription_form',
                      class: 'task-subscription-form' },
              data: { turbo_method: :post }) do |form| %>
  <%= form.submit 'Auto-Subscribe to New Tasks',
                  class: 'button button-wrap button-clear',
                  title: 'Subscribe',
                  data: { disable_with: 'Subscribing...', turbo_submits_with: 'Subscribing...' } %>
<% end %>
