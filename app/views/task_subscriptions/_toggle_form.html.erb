<% if task_subscription.active %>
  <div class="button-wrapper">
    <%= link_to 'Subscribed',
                task_task_subscription_path(task, task_subscription),
                class: 'button button-success button-disabled' %>
    <%= form_with(model: task_subscription,
                  url: toggle_task_task_subscription_path(task, task_subscription),
                  html: { name: 'task_subscription_destroy_form',
                          class: 'task-subscription-form' }) do |form| %>
      <%= button_tag class: 'button button-success button-unsubscribe button-icon',
                     title: 'Unsubscribe',
                     data: { turbo_submits_with: '...' } do %>
        <%= icon('close') %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= form_with(model: task_subscription,
                url: toggle_task_task_subscription_path(task, task_subscription),
                html: { name: 'task_subscription_form',
                        class: 'task-subscription-form' }) do |form| %>
    <%= form.submit 'Subscribe to task',
                    class: 'button button-outline',
                    title: 'Subscribe',
                    data: { turbo_submits_with: 'Subscribing...' } %>
  <% end %>
<% end %>
