<% return unless task  %>

<% if task_subscription.persisted? %>
  <% return unless can?(:destroy, task_subscription) %>

  <%= render 'task_subscriptions/toggle_form',
             task_subscription: task_subscription, task: task %>
<% elsif can?(:create, task_subscription) %>
  <%= render 'task_subscriptions/form',
             task_subscription: task_subscription, task: task %>
<% end %>
