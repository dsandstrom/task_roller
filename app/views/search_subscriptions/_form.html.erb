<%= form_with(model: search_subscription,
              html: { name: 'search_subscription_form',
                      class: 'search-subscription-form',
                      novalidate: 'novalidate' }) do |form| %>
  <%= form.hidden_field :category_id %>
  <%= form.hidden_field :project_id %>
  <%= form.hidden_field :source_user_id %>
  <%= form.hidden_field :term %>
  <%= form.hidden_field :include_issues %>
  <%= form.hidden_field :include_tasks %>
  <%= form.hidden_field :issue_type_id %>
  <%= form.hidden_field :task_type_id %>
  <%= form.hidden_field :issue_status %>
  <%= form.hidden_field :task_status %>
  <%= form.submit 'Auto-Subscribe', class: 'button button-outline', title: 'Subscribe',
                                    data: { turbo_submits_with: 'Subscribing...' } %>
<% end %>
