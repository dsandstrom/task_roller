<%= task_header(@task) %>

<h2>Edit Comment</h2>

<%= turbo_frame_tag @task_comment do %>
  <%= render 'shared/comment_header', comment: @task_comment, notification: nil %>

  <main>
    <%= render 'form', task: @task,
                       task_comment: @task_comment %>
  </main>
<% end %>

<p><%= link_to 'Back', :back %></p>
