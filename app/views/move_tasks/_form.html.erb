<% url = move_task_path(task) %>

<%= form_with(model: task, url: url, method: :patch,
              html: { name: 'move_task_form' }) do |form| %>
  <%= form_errors(form.object) %>

  <div class="field">
    <%= form.label :project_id %>
    <%= form.select :project_id, grouped_options_for_select(project_options) %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
