<% show_status_filter = true unless show_status_filter == false %>
<% if issues.any? || searching? %>
  <%= render 'shared/page_links', collection: issues %>
<% end %>

<div class="columns">
  <div class="first-column">
    <% if issues.any? || searching? %>
      <%= render 'issues/issues', issues: issues %>

      <%= render 'shared/simple_page_links', collection: issues %>
    <% else %>
      <p class="no-issue">None yet</p>
    <% end %>
  </div>

  <div class="second-column">
    <% if issues.any? || searching? %>
      <%= render 'issues/filter_form', issues: issues,
                                       show_status_filter: show_status_filter %>
    <% end %>
  </div>
</div>
