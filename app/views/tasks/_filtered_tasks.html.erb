<%
show_status_filter = true unless show_status_filter == false
search_subscription ||= nil
%>

<% if tasks.any? || searching? %>
  <%= render 'shared/page_links', collection: tasks %>
<% end %>

<div class="columns">
  <div class="first-column">
    <% if tasks.any? || searching? %>
      <%= render 'tasks/tasks', tasks: tasks %>

      <%= render 'shared/simple_page_links', collection: tasks %>
    <% else %>
      <p class="no-task">None yet</p>
    <% end %>
  </div>

  <div class="second-column">
    <% if tasks.any? || searching? %>
      <%= render 'tasks/filter_form',
                 tasks: tasks, show_status_filter: show_status_filter,
                 search_subscription: search_subscription %>
    <% end %>
  </div>
</div>
