<%
path ||= request.path
return unless path

show_status_filter = true unless show_status_filter == false
%>

<div class="filters-wrapper">
  <div class="heading-and-link">
    <h3>Filters</h3>

    <% if searching? %>
      <%= link_to 'reset', path %>
    <% end %>
  </div>

  <%= form_tag path, method: :get, class: "task-filter-form" do %>
    <%= render 'shared/string_filter_field', placeholder: 'tasks' %>
    <%= render 'tasks/status_filter_field' if show_status_filter %>
    <%= render 'tasks/task_type_filter_field' %>
    <%= render 'shared/order_filter_field' %>

    <div class="actions">
      <%= submit_tag 'Filter' %>
    </div>
  <% end %>
</div>

<% if @search_subscription.present? %>
  <div class="filters-wrapper search-subscription-wrapper">
    <h3>Save &amp; Subscribe</h3>

    <%= render 'search_subscriptions/title', search_subscription: @search_subscription %>

    <div class="field">
      <% if @search_subscription.persisted? %>
        <%= render 'search_subscriptions/toggle_form',
                   search_subscription: @search_subscription %>
      <% else %>
        <%= render 'search_subscriptions/form',
                   search_subscription: @search_subscription %>
      <% end %>
    </div>

    <p><%= link_to 'All Saved Searches', search_subscriptions_path %></p>
  </div>
<% end %>
