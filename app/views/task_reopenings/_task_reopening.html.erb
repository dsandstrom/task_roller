<%
show_id = true unless show_id == false

id_part = " (##{task_reopening.task_id})" if show_id
value = "reopened#{id_part}: #{format_date task_reopening.created_at}"
%>

<%= content_tag :dt, task_reopening.user&.name_or_email,
                class: 'task-reopening-user' %>
<%= content_tag :dd, value,
                class: "task-reopening",
                id: "task-reopening-#{task_reopening.id}" %>
