<% return unless can?(:create, comment) %>

<div id="new_comment" class="comment new-comment">
  <header>
    <div class="header-box">
      <p>Add Comment:</p>
    </div>
  </header>

  <%= turbo_frame_tag :turbo_new_comment do %>
    <%= render 'shared/new_comment_form', object: object %>
  <% end %>
</div>
