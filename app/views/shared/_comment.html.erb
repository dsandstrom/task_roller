<%
  notification = comment.notifications
                        .find_by(user_id: current_user.id)
  html_class = 'comment'
  if object.user_id == comment.user_id
    html_class += ' original-user'
  end
  if comment.user_id == current_user.id
    html_class += ' current-user'
  end
  if notification.present?
    html_class += ' with-notification'
  end
%>

<div id="comment-<%= comment.id %>" class="<%= html_class %>">
  <%= turbo_frame_tag comment do %>
    <%= render 'shared/comment_header', comment: comment, notification: notification %>

    <main>
      <%= content_tag :div, comment.body_html.html_safe,
                      class: 'comment-body' %>
    </main>

    <% if can?(:update, comment) || can?(:destroy, comment) || can?(:create, Issue) %>
      <footer>
        <p>
          <% if object.is_a?(Task) %>
            <% if can?(:update, comment) %>
              <%= link_to 'edit',
                          edit_task_task_comment_path(object, comment) %>
            <% end %>
            <% if can?(:destroy, comment) %>
              <%= divider %>
              <%= link_to 'delete',
                          task_task_comment_path(object, comment),
                          method: :delete, class: 'destroy-link',
                          data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to remove this comment?' } %>
            <% end %>
            <% if can?(:create, new_issue(object.project)) %>
              <%= link_to 'Copy to new issue',
                          new_issue_path(project_id: object.project_id,
                                         source_task_id: object.to_param,
                                         task_comment_id: comment.to_param),
                                         data: { turbo_frame: '_top' } %>
            <% elsif can?(:create, Issue) %>
              <%= link_to 'Copy to new issue',
                          new_issue_path(source_task_id: object.to_param,
                                         task_comment_id: comment.to_param),
                                         data: { turbo_frame: '_top' } %>
            <% end %>
            <% if can?(:create, new_task(object.project)) %>
              <%= link_to 'Copy to new task',
                          new_project_task_path(object.project, source_task_id: object.to_param,
                                                                task_comment_id: comment.to_param),
                                                                data: { turbo_frame: '_top' } %>
            <% elsif can?(:create, Task) %>
              <%= link_to 'Copy to new task',
                          new_projects_task_path(source_task_id: object.to_param,
                                                 task_comment_id: comment.to_param),
                                                 data: { turbo_frame: '_top' } %>
            <% end %>
          <% else %>
            <% if can?(:update, comment) %>
              <%= link_to 'edit',
                          edit_issue_issue_comment_path(object, comment) %>
            <% end %>
            <% if can?(:destroy, comment) %>
              <%= divider %>
              <%= link_to 'delete',
                          issue_issue_comment_path(object, comment),
                          method: :delete, class: 'destroy-link',
                          data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to remove this comment?' } %>
            <% end %>
            <% if can?(:create, new_issue(object.project)) %>
              <%= link_to 'Copy to new issue',
                          new_issue_path(project_id: object.project_id,
                                         source_issue_id: object.to_param,
                                         issue_comment_id: comment.to_param),
                                         data: { turbo_frame: '_top' } %>
            <% elsif can?(:create, Issue) %>
              <%= link_to 'Copy to new issue',
                          new_issue_path(source_issue_id: object.to_param,
                                         issue_comment_id: comment.to_param),
                                         data: { turbo_frame: '_top' } %>
            <% end %>
            <% if can?(:create, new_task(object.project)) %>
              <%= link_to 'Copy to new task',
                          new_project_task_path(object.project, source_issue_id: object.to_param,
                                                                issue_comment_id: comment.to_param),
                                                                data: { turbo_frame: '_top' } %>
            <% elsif can?(:create, Task) %>
              <%= link_to 'Copy to new task',
                          new_projects_task_path(source_issue_id: object.to_param,
                                                 issue_comment_id: comment.to_param),
                                                 data: { turbo_frame: '_top' } %>
            <% end %>
          <% end %>
        </p>
      </footer>
    <% end %>
  <% end %>
</div>
