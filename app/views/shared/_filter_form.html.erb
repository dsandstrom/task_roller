<%
return unless path

reset_path ||= path

search_subscription ||= nil
%>

<div class="filters-wrapper">
  <div class="heading-and-link">
    <h3>Filters</h3>

    <% if searching? %>
      <%= link_to 'reset', reset_path %>
    <% end %>
  </div>

  <%= form_tag path,
               method: :get, class: "search-form",
               id: "search_form" do %>
    <%= render 'shared/string_filter_field' %>
    <%= render 'searches/type_filter_field' %>
    <%= render 'shared/order_filter_field' %>

    <div class="actions">
      <%= submit_tag 'Filter' %>
    </div>
  <% end %>
</div>

<% if search_subscription.present? %>
  <%= render('search_subscriptions/forms', search_subscription: search_subscription) %>
<% end %>
