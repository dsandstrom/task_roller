<%= form_with(model: category_issues_subscription,
              url: category_issues_subscription_path(category, category_issues_subscription),
              method: :delete,
              html: { name: 'category_issue_subscription_destroy_form',
                      class: 'issue-subscription-form' },
              data: { turbo_method: 'destroy' }) do |form| %>
  <%= button_tag class: 'button button-success button-unsubscribe button-icon',
                 title: 'Unsubscribe',
                 data: { turbo_submits_with: '...' } do %>
    <%= icon('close') %>
  <% end %>
<% end %>
