<%
  url =
    if category_issues_subscription.persisted?
      category_issues_subscription_path(category, category_issues_subscription)
    else
      category_issues_subscriptions_path(category)
    end
%>
<%= form_with(model: category_issues_subscription,
              url: url,
              html: { name: 'issue_subscription_form',
                      class: 'issue-subscription-form' },
              data: { turbo_method: :post }) do |form| %>
  <%= form.submit 'Auto-Subscribe to New Issues',
                  class: 'button button-wrap button-clear',
                  title: 'Subscribe',
                  data: { disable_with: 'Subscribing...', turbo_submits_with: 'Subscribing...' } %>
<% end %>
