<%= user_header(@user) %>

<header class="tasks-header">
  <h2>Tasks Ready for Review</h2>
</header>

<div class="reviews">
  <% if @tasks.any? || searching? %>
    <%= render 'tasks/tasks', tasks: @tasks, show_status_filter: false %>
  <% else %>
    <p class="no-reviews">all caught up</p>
  <% end %>
</div>
