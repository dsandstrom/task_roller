<% if issue_subscription.persisted? %>
  <% return unless can?(:update, issue_subscription) %>

  <%= render 'issue_subscriptions/toggle_form',
             issue_subscription: issue_subscription, issue: issue %>
<% elsif issue && can?(:create, issue_subscription) %>
  <%= render 'issue_subscriptions/form',
             issue_subscription: issue_subscription, issue: issue %>
<% end %>
